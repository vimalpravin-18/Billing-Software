# BakeryPOS Backend Environment Configuration
# Copy this file to .env or configure in system environment variables before deployment

# Server Port
PORT=8080

# PostgreSQL Production Database Connection (Local or Supabase)
# For Local: jdbc:postgresql://localhost:5432/bakerypos_db
# For Supabase: jdbc:postgresql://db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/bakerypos_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_secure_db_password

# Hibernate DDL Auto (Use 'validate' or 'update' in production)
JPA_DDL_AUTO=update
SHOW_SQL=false

# Production 256-bit JWT Secret Key (Generate a random 64-character hex string)
JWT_SECRET=your_secure_random_64_character_hex_jwt_secret_key
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated URLs of frontend domains)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://yourdomain.com

# Logging Level (INFO, WARN, ERROR)
LOG_LEVEL=INFO