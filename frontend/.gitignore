# ==============================================================================
# Frontend (React / Vite) .gitignore
# ==============================================================================

# Node dependencies
node_modules/
/.pnp
.pnp.js

# Build output
dist/
dist-ssr/

# Environment files and secrets
.env
.env.*
!.env.example
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories and files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.oxlint-cache
